<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Cue4ParseBinary Condition="'$(Cue4ParseBinary)' == ''">$(MSBuildThisFileDirectory)..\..\.tools\bin\CUE4Parse\CUE4Parse.dll</Cue4ParseBinary>
  </PropertyGroup>
  <ItemGroup Condition="'$(Cue4ParseProject)' != ''">
    <ProjectReference Include="$(Cue4ParseProject)" />
  </ItemGroup>
  <ItemGroup Condition="'$(Cue4ParseProject)' == ''">
    <Reference Include="CUE4Parse">
      <HintPath>$(Cue4ParseBinary)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.11" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
  </ItemGroup>
  <Target Name="RequireCanonicalCue4Parse" BeforeTargets="ResolveReferences" Condition="'$(Cue4ParseProject)' == ''">
    <Error Condition="!Exists('$(Cue4ParseBinary)')" Text="Canonical CUE4Parse bundle is missing. Run tools\Publish-Cue4ParseBinary.ps1." />
  </Target>
</Project>
