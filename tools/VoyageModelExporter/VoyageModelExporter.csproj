<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="../../.tools/bin/CUE4Parse/*.dll"><Private>true</Private></Reference>
    <Content Include="../../.tools/bin/oo2core_9_win64.dll" Link="oo2core_9_win64.dll" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../../.tools/CUE4Parse/CUE4Parse-Conversion/**/*.cs"
             Exclude="../../.tools/CUE4Parse/CUE4Parse-Conversion/obj/**;../../.tools/CUE4Parse/CUE4Parse-Conversion/bin/**" />
    <EmbeddedResource Include="../../.tools/CUE4Parse/CUE4Parse-Conversion/Resources/*.dll">
      <LogicalName>CUE4Parse_Conversion.Resources.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <PackageReference Include="AssetRipper.TextureDecoder" Version="2.6.2" />
    <PackageReference Include="SharpGLTF.Core" Version="1.0.6" />
    <PackageReference Include="SharpGLTF.Toolkit" Version="1.0.6" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
  </ItemGroup>
</Project>
