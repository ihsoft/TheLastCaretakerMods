{
  "schemaVersion": 2,
  "groups": [
    {
      "id": "controls",
      "comments": [
        "Re-read on each entry; exit before editing. No package rebuild is required.",
        "Exact case-sensitive keys; inline # comments are supported."
      ],
      "settings": [
        { "id": "Yaw", "runtimeName": "RailgunYawLimitDegrees", "key": "YawLimitDegrees", "type": "number", "default": 80, "minimum": 1, "maximum": 170 },
        { "id": "PitchMin", "runtimeName": "RailgunMinimumPitchDegrees", "key": "MinimumPitchDegrees", "type": "number", "default": -30, "minimum": -89, "maximum": 0 },
        { "id": "PitchMax", "runtimeName": "RailgunMaximumPitchDegrees", "key": "MaximumPitchDegrees", "type": "number", "default": 30, "minimum": 0, "maximum": 89 }
      ]
    },
    {
      "id": "audio",
      "settings": [
        { "id": "ShotVolume", "field": "ShotAudio::VolumePercent", "key": "ShotVolumePercent", "type": "number", "default": 600, "minimum": 0, "maximum": 1000000000 }
      ]
    },
    {
      "id": "gameplay",
      "comments": ["Gameplay tuning uses the same KWh energy unit shown by the game."],
      "settings": [
        { "id": "HitDamage", "field": "ShotAttack::ConfiguredDamage", "key": "HitDamage", "type": "number", "default": 350, "minimum": 0, "maximum": 1000000000 },
        { "id": "FullChargeEnergy", "field": "Charge::ConfiguredEnergyKWh", "key": "FullChargeEnergyKWh", "type": "number", "default": 0.85, "minimum": 0.001, "maximum": 1000000000 },
        { "id": "FullChargeTime", "field": "Charge::ConfiguredTimeSeconds", "key": "FullChargeTimeSeconds", "type": "number", "default": 5.5, "minimum": 0.001, "maximum": 86400 },
        { "id": "IdleConsumption", "field": "Charge::ConfiguredIdleConsumptionKW", "key": "IdleConsumptionKW", "type": "number", "default": 1, "minimum": 0, "maximum": 1000000000 },
        { "id": "CameraRecoilStrength", "runtimeName": "RailgunCameraRecoilStrength", "key": "CameraRecoilStrength", "type": "number", "default": 0.5, "minimum": 0, "maximum": 10 },
        { "id": "ShipRecoilStrength", "runtimeName": "RailgunShipRecoilStrength", "key": "ShipRecoilStrength", "type": "number", "default": 2, "minimum": 0, "maximum": 10 }
      ]
    }
  ]
}
