# Local tool checkouts and build output
.tools/
**/bin/
**/obj/

# All game-derived artifacts are local, version-specific, and reproducible.
# Promote useful conclusions to docs/ and repeatable extraction logic to tools/.
/artifacts/*
!/artifacts/README.md
!/artifacts/AGENTS.md
/Tmp/

# Runtime logs and temporary files
*.log
*.tmp

# Distribution archives are generated artifacts
dist/*.zip
